PORT=5000
NODE_ENV=production
# MongoDB Atlas connection string. Keep the password URL-encoded.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
CORS_ORIGIN=*

# Email Notifications via Gmail (Contact Form)
# To enable: Generate App Password from https://myaccount.google.com/apppasswords
# See GMAIL_SETUP.md for detailed instructions
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
EMAIL_RECEIVER=your_email@gmail.com
